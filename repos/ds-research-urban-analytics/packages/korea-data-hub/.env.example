# ============================================================
# Korea Data Hub — 환경변수 템플릿
# cp .env.example .env 후 값을 채우세요. .env는 git에 올리지 마세요.
# ============================================================

# --- 공공데이터포털 (디코딩 serviceKey) ---
DATA_GO_KR_KEY=
MOLIT_API_KEY=
MOLIT_API_BASE=https://apis.data.go.kr/1613000/RTMSDataSvcAptTrade

# --- 법원 경매 (없으면 DATA_GO_KR_KEY 사용) ---
COURT_AUCTION_KEY=
COURT_AUCTION_BASE=https://apis.data.go.kr/Courtauction

# --- 환율 (한국은행 ECOS 또는 공공데이터) ---
EXCHANGE_RATE_KEY=
BOK_ECOS_KEY=
EXCHANGE_RATE_BASE=https://ecos.bok.or.kr/api/StatisticSearch

# --- DART 전자공시 ---
DART_API_KEY=
DART_API_BASE=https://opendart.fss.or.kr/api
